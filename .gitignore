# Build output — scripts/build.js regenerates these on every Vercel deploy.
# The build exits non-zero if it fails, so Vercel keeps the last good
# deployment live rather than shipping a site without them.
/products/
/collections/
/sitemap.xml

# Local tooling, not part of the site. .claude/skills IS committed:
# cloud sessions do not load a developer's personal ~/.claude/skills,
# so project skills have to live in the repo to be available at all.
.claude/*
!.claude/skills/
.agents/
skills-lock.json
.vercel

.DS_Store
node_modules/

# Content-hashed image aliases written by scripts/build.js (item: stale
# image cache). The canonical images/<name>.<ext> files stay in git;
# these are regenerated on every build, including on Vercel.
images/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].jpg
images/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].jpeg
images/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].png
images/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].webp
images/*.[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].avif
