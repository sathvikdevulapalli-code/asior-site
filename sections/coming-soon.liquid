{%- comment -%}
  Colors are hardcoded (not theme color schemes) since this design is
  locked to a specific black/off-white palette regardless of the merchant's
  theme settings.
{%- endcomment -%}
{%- style -%}
  #ComingSoon-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: #000000;
  }

  #ComingSoon-{{ section.id }} .coming-soon__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #ComingSoon-{{ section.id }} .coming-soon__logo {
    width: 170px;
    height: 170px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ComingSoon-{{ section.id }} .coming-soon__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #ComingSoon-{{ section.id }} .coming-soon__logo--text {
    color: #f2f2f0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 17px;
    font-weight: 400;
    text-transform: lowercase;
  }

  #ComingSoon-{{ section.id }} .coming-soon__subtitle {
    margin: 56px 0 0;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: #f2f2f0;
  }

  #ComingSoon-{{ section.id }} .coming-soon__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    margin-top: 30px;
  }

  #ComingSoon-{{ section.id }} .coming-soon__nav a {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #f2f2f0;
    text-decoration: none;
    transition: color 120ms ease;
  }

  #ComingSoon-{{ section.id }} .coming-soon__nav a:hover {
    color: #9a9a96;
  }

  @media screen and (max-width: 480px) {
    #ComingSoon-{{ section.id }} .coming-soon__logo {
      width: 120px;
      height: 120px;
    }
  }
{%- endstyle -%}

<div id="ComingSoon-{{ section.id }}" class="coming-soon">
  <div class="coming-soon__stack">
    {%- if section.settings.logo != blank -%}
      <div class="coming-soon__logo">
        {{ section.settings.logo | image_url: width: 340 | image_tag: loading: 'eager', width: 170, height: 170, alt: shop.name }}
      </div>
    {%- else -%}
      <div class="coming-soon__logo coming-soon__logo--text">{{ shop.name }}</div>
    {%- endif -%}

    <p class="coming-soon__subtitle">{{ section.settings.subtitle }}</p>

    <nav class="coming-soon__nav">
      <a href="{{ section.settings.shop_all_url }}">shop all</a>
      <a href="{{ section.settings.jag_collection_url }}">jag collection</a>
      <a href="{{ section.settings.community_url }}">community</a>
      <a href="{{ section.settings.contact_url }}">contact</a>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Coming soon",
  "class": "section-coming-soon",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "White/light artwork on transparent background reads best on the black backdrop. Falls back to the store name if left blank."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "dropping soon"
    },
    {
      "type": "header",
      "content": "Navigation links"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "\"shop all\" link",
      "default": "/collections/all"
    },
    {
      "type": "url",
      "id": "jag_collection_url",
      "label": "\"jag collection\" link",
      "default": "/collections/jag"
    },
    {
      "type": "url",
      "id": "community_url",
      "label": "\"community\" link",
      "info": "Placeholder until the real community/lookbook page URL is confirmed."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "\"contact\" link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Coming soon"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
